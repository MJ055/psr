## ---------------------------------------------------------------------------
## PasarGuard — Railway (and generic Docker) environment template
## Copy the values you need into Railway → Variables, or into a local .env
## ---------------------------------------------------------------------------

## Panel ---------------------------------------------------------------
UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000
DEBUG = False
DOCS = True
ALLOWED_ORIGINS = "*"

## Database ------------------------------------------------------------
## Leave empty to use SQLite on the mounted volume (/var/lib/pasarguard).
## Railway: add the PostgreSQL plugin, then set this to its DATABASE_URL value
## with the async driver prefix, e.g.
##   SQLALCHEMY_DATABASE_URL = "postgresql+asyncpg://user:pass@host:5432/railway"
# SQLALCHEMY_DATABASE_URL = ""
SQLALCHEMY_POOL_SIZE = 5
SQLALCHEMY_MAX_OVERFLOW = 5

## Owner bootstrap (optional) ------------------------------------------
## When both are set, the container creates the owner on first boot.
## Password rules: 12+ chars, 2 uppercase, 2 lowercase, 2 digits, 1 symbol.
# SUDO_USERNAME = "admin"
# SUDO_PASSWORD = "ChangeMe@Panel2026"

## Self service sign-up on the login page ------------------------------
SELF_REGISTRATION = True

## Admin caps — disabled on purpose: no user-count / traffic limits ----
ENFORCE_ADMIN_LIMITS = False

## Backups (sidebar → Backups) -----------------------------------------
BACKUP_DIRECTORY = "/var/lib/pasarguard/backups"
BACKUP_MAX_KEEP = 20
BACKUP_AUTO_ENABLED = False
BACKUP_AUTO_INTERVAL_HOURS = 24

## TLS — Railway terminates TLS for you, so keep these empty ----------
# UVICORN_SSL_CERTFILE = ""
# UVICORN_SSL_KEYFILE = ""

## Behind Railway's proxy: trust the forwarded headers ---------------
UVICORN_PROXY_HEADERS = True
UVICORN_FORWARDED_ALLOW_IPS = "*"

## Subscription paths --------------------------------------------------
SUBSCRIPTION_PATH = "sub"

## Sessions -----------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440

## Logs ----------------------------------------------------------------
LOG_LEVEL = "INFO"
SAVE_LOGS_TO_FILE = False
